# ============ Database ============
# CLOUD (Render + Supabase): Postgres connection string — Supabase dashboard →
# Project Settings → Database → Connection string (use the SESSION pooler,
# port 5432, for IPv4 compatibility with Render).
# When set, ALL app data lives in Postgres and SQLite is bypassed.
DATABASE_URL=
# Alias accepted if you prefer naming it after the provider:
SUPABASE_DB_URL=

# LOCAL ONLY: SQLite file location. Ignored when DATABASE_URL is set.
# Defaults to ./data/smart-sugar.db. Use ":memory:" for a throwaway store.
SMART_SUGAR_DB=

# ============ Auth (admin + viewers) ============
# HMAC secret that signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, a random secret is generated once and stored in the DB (fine for
# a single instance; set it explicitly so sessions survive redeploys).
AUTH_SECRET=
# First-boot admin account (created only when the users table is empty).
# CHANGE THE DEFAULT PASSWORD after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Sugar@2026
# Set to 1 only if you must serve over plain http:// (local network). Render
# serves https:// so cookies stay Secure automatically.
AUTH_INSECURE_COOKIE=

# ============ Cron / refresh ============
# Secret for GET /api/refresh?token=… (scheduler pings, Render cron job).
# Generate a long random string.
REFRESH_TOKEN=

# ============ Market data ============
# Barchart OnDemand API key — PAID subscription required.
# When set, /api/market switches from Yahoo front-month to real Barchart quotes.
# Request: https://www.barchart.com/ondemand/api/getQuote
BARCHART_API_KEY=

# VesselFinder AIS. Enables the logistics card status only.
VESSELFINDER_API_KEY=

# Open-Meteo coordinates — Santos, Brazil.
WEATHER_LAT=-23.96
WEATHER_LON=-46.33

# ============ LLM (AI chat assistant, OpenAI-compatible) ============
# Examples: OpenAI, Azure OpenAI, Groq, Together, Anyscale, local Ollama...
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============ Uploads (drivers briefings) ============
# Set to 1 only on a host with a persistent disk to enable PDF/Excel uploads.
# Daily-reports uploads work regardless (they store into the DB in cloud mode).
NEXT_PUBLIC_UPLOAD_ENABLED=
